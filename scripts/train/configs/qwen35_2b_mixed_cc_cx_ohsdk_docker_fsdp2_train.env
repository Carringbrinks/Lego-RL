# Qwen3.5-2B + mixed Claude Code / Codex CLI / OpenHands SDK + Docker + FSDP2.
#
# Hardware target: eight RTX 4090 D GPUs (24 GiB each), no NVLink.
# Training and rollout are colocated in synchronous mode.
#
# Rows without agent_harness metadata use weighted selection. The default
# granularity is "task": one task/global-step selects one harness, and all
# sibling rollouts for that task reuse it. Set
# HARBOR_HARNESS_GRANULARITY=trajectory to draw independently per rollout.
#
# Explicit data metadata remains authoritative:
#   extra_info.agent_harness in {claude_code, codex, openhands_sdk}

# --- template selection -----------------------------------------------
BACKEND=docker
SCAFFOLD=mixed
TRAINING_MODE=sync
MODEL_ENGINE=fsdp

# --- identity ----------------------------------------------------------
PROJECT_NAME=lego-rl-qwen35-2b-mixed-cc-cx-ohsdk
EXP_NAME=qwen35-2b-mixed-cc-cx-ohsdk-docker-fsdp2-train-8gpu-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=${REPO_ROOT}/.venv
TRAIN_NETWORK_INTERFACE=ens5f1
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_BUILDKIT=1
HARBOR_DOCKER_BUILD_CONCURRENCY=2
# Set LEGO_DOCKER_BUILD_PROXY only when task-image Dockerfile RUN steps need
# an HTTP proxy. Runtime images are pulled separately.
HARBOR_DOCKER_BUILD_PROXY=${LEGO_DOCKER_BUILD_PROXY-}
HARBOR_DOCKER_BUILD_NO_PROXY=${LEGO_DOCKER_BUILD_NO_PROXY:-localhost,127.0.0.1,::1,host.docker.internal,192.168.19.3,172.17.0.1,.local}
RAY_OBJECT_STORE_MEMORY=6000000000
CUDA_HOME=/usr/local/cuda-12.8
LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH:-}
CUDA_VISIBLE_DEVICES=${LEGO_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}

AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_mixed_cc_cx_ohsdk_docker.yaml

# --- model -------------------------------------------------------------
MODEL_PATH=${LEGO_MODEL_PATH:-/mnt/data/models/Qwen3.5-2B}
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder

ENABLE_R3=False
ENABLE_ROLLOUT_ROUTING_REPLAY=False
VLLM_ENABLE_EXPERT_PARALLEL=False

# --- data --------------------------------------------------------------
DEFAULT_INDEX=${REPO_ROOT}/data/Lego-RL-subset-64/index/train_64.parquet
TRAIN_FILES=${LEGO_TRAIN_FILES:-${DEFAULT_INDEX}}
VAL_FILES=${LEGO_VAL_FILES:-${TRAIN_FILES}}

# --- topology ----------------------------------------------------------
NNODES=1
NGPUS_PER_NODE=8
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# SP=1 gives eight data-parallel ranks. vLLM remains one GPU per replica.
SP_SIZE=1
GEN_TP=1
FSDP_STRATEGY=fsdp2
FSDP_SIZE=-1

# --- training scale ----------------------------------------------------
TRAIN_BSZ=2
TRAIN_PROMPT_BSZ=2
TRAIN_MINI_BSZ=2
N_RESP=4
VAL_BSZ=1
VAL_N=1

# --- context and 24 GiB memory controls -------------------------------
FUSED_KERNELS=True
NVCC_PREPEND_FLAGS="-ccbin /usr/bin/g++-11"
MAX_PROMPT=61440
MAX_RESP=20480
ROLLOUT_MAX_MODEL_LEN=81920
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=81920
GPU_MEM_UTIL=0.50
ENFORCE_EAGER=True
ENABLE_SLEEP_MODE=True
ROLLOUT_MAX_NUM_SEQS=8
ENABLE_GRADIENT_CHECKPOINTING=True
ENABLE_ACTIVATION_OFFLOAD=False

# FSDP2 uses CPUOffloadPolicy for parameter/optimizer movement across devices.
ACTOR_FSDP_PARAM_OFFLOAD=False
ACTOR_FSDP_OPTIMIZER_OFFLOAD=False
ACTOR_FSDP_OFFLOAD_POLICY=True
REF_FSDP_PARAM_OFFLOAD=False
REF_FSDP_OFFLOAD_POLICY=True

# --- shared agent / sandbox controls -----------------------------------
AGENT_NUM_WORKERS=4
HARBOR_AGENT_NAME=null

# The completion-turn value is also used by the loop for termination labels.
# Each harness's actual cap is set separately below.
HARBOR_AGENT_MAX_ITERATIONS=50
HARBOR_AGENT_TEMPERATURE=1.0
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=3600
HARBOR_MAX_RETRIES=1
HARBOR_VAL_MAX_RETRIES=0
HARBOR_TRAJECTORY_SELECTION=longest
HARBOR_MAX_CONSECUTIVE_NO_TOOL=3

HARBOR_ENVIRONMENT_TYPE=docker
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.remote_docker:RemoteDockerEnvironment
HARBOR_ENVIRONMENT_FORCE_BUILD=True
HARBOR_ENVIRONMENT_DELETE=True
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_VERIFIER_ENABLED=True

# --- Claude Code runtime ----------------------------------------------
HARBOR_MIXED_CC_IMPORT_PATH=harbor_patch.agents.image_mounted_claude_code:ClaudeCode
HARBOR_MIXED_CC_RUNTIME_IMAGE=${LEGO_CC_IMAGE:-jierun/c-cc-2.1.207:v0.1}
HARBOR_MIXED_CC_RUNTIME_MOUNT_PATH=/opt/custom-agent-runtime/claude-code
HARBOR_MIXED_CC_RUNTIME_IMAGE_SUBPATH=opt/custom-agent-runtime/claude-code
HARBOR_MIXED_CC_CUSTOM_AGENT_CLAUDE=/opt/custom-agent-runtime/claude-code/bin/claude
HARBOR_MIXED_CC_RUNTIME_ENV_SCRIPT=/opt/custom-agent-runtime/claude-code/runtime-env.sh
HARBOR_MIXED_CC_MAX_ITERATIONS=50
HARBOR_MIXED_CC_MAX_TIMEOUT_SEC=900
HARBOR_MIXED_CC_OVERRIDE_TIMEOUT_SEC=900

HARBOR_ANTHROPIC_API_KEY=sk-dummy
HARBOR_ANTHROPIC_MODEL=${SERVED_MODEL_NAME}
CLAUDE_CODE_ATTRIBUTION_HEADER=0

# --- Codex CLI runtime ------------------------------------------------
HARBOR_MIXED_CX_IMPORT_PATH=harbor_patch.agents.image_mounted_codex:Codex
HARBOR_MIXED_CX_VERSION=0.153.4
HARBOR_MIXED_CX_RUNTIME_IMAGE=${LEGO_CODEX_IMAGE:-jierun/c-codex-0.153.4:v0.1}
HARBOR_MIXED_CX_RUNTIME_MOUNT_PATH=/opt/custom-agent-runtime/codex
HARBOR_MIXED_CX_RUNTIME_IMAGE_SUBPATH=opt/custom-agent-runtime/codex
HARBOR_MIXED_CX_STAGE_HELPER_IMAGE=alpine:3.20
HARBOR_MIXED_CX_MAX_ITERATIONS=50
HARBOR_MIXED_CX_MAX_TIMEOUT_SEC=900
HARBOR_MIXED_CX_OVERRIDE_TIMEOUT_SEC=900

HARBOR_OPENAI_API_KEY=sk-dummy
CODEX_REASONING_EFFORT=medium

# --- OpenHands SDK runtime --------------------------------------------
HARBOR_MIXED_OHSDK_IMPORT_PATH=harbor.agents.custom.openhands_sdk:CustomOpenHandsSDK
HARBOR_MIXED_OHSDK_VERSION=1.33.0
HARBOR_MIXED_OHSDK_RUNTIME_IMAGE=${LEGO_OHSDK_IMAGE:-docker.io/jierun/c-oh-sdk-1.33.0:v0.1}
HARBOR_MIXED_OHSDK_RUNTIME_MOUNT_PATH=/opt/custom-agent-runtime/oh-sdk
HARBOR_MIXED_OHSDK_RUNTIME_IMAGE_SUBPATH=opt/custom-agent-runtime/oh-sdk
HARBOR_MIXED_OHSDK_MAX_ITERATIONS=50
HARBOR_MIXED_OHSDK_MAX_TIMEOUT_SEC=900
HARBOR_MIXED_OHSDK_OVERRIDE_TIMEOUT_SEC=900
HARBOR_AGENT_ENABLE_SUMMARIZE=True
HARBOR_AGENT_PROACTIVE_SUMMARIZATION_THRESHOLD=49152
HARBOR_AGENT_INTERLEAVED_THINKING=False
HARBOR_AGENT_MODEL_INFO="{max_input_tokens: 61440, max_output_tokens: 20480, input_cost_per_token: 0, output_cost_per_token: 0}"

# --- mixed harness selection ------------------------------------------
# No metadata: weighted_random with task granularity.
HARBOR_HARNESS_DEFAULT=openhands_sdk
HARBOR_HARNESS_FALLBACK=weighted_random
HARBOR_HARNESS_GRANULARITY=task
HARBOR_HARNESS_RANDOM_SEED=1234
HARBOR_HARNESS_WEIGHT_CC=1.0
HARBOR_HARNESS_WEIGHT_CX=1.0
HARBOR_HARNESS_WEIGHT_OHSDK=1.0
# Validation is kept on one harness so metrics remain comparable.
HARBOR_VAL_HARNESS=openhands_sdk

# --- training cadence --------------------------------------------------
ADV_ESTIMATOR=grpo
POLICY_LOSS_MODE=gspo
LR_SCHEDULER=constant
ACTOR_LR=1e-6
TOTAL_EPOCHS=1
TRAINER_SAVE_FREQ=10
MAX_ACTOR_CKPT_TO_KEEP=3
TRAINER_TEST_FREQ=-1
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_LOGGER="['console']"
WANDB_MODE=disabled

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
