# =============================================================================
# Qwen3.5-2B + Codex CLI + Docker + FSDP2 training on Lego-RL-2699.
#
# 运行：
#   bash scripts/train/train.sh scripts/train/configs/qwen35_2b_cx_docker_fsdp2_train.env
#
# 本文件是 train.sh 的声明式参数表：
#   1) 先 source 本文件；
#   2) 再按 TEMPLATE_MODULES 顺序 source scripts/templates/...；
#   3) 模板用 `: "${VAR:=default}"` 只补默认值，所以本文件永远优先。
#
# 分组规则：每个分组标题注明它覆盖哪个模板文件；没标模板的变量由
# train.sh / verl / Harbor 直接读取。
#
# 硬件目标：8× RTX 4090 D（24 GiB，无 NVLink），dense 模型，sync 共卡训练。
# Codex 0.144.1 已烘焙进统一 agent 基础镜像。
# =============================================================================


# -----------------------------------------------------------------------------
# 0. 模板选择（不覆盖任何模板；决定后面 source 哪些文件）
# -----------------------------------------------------------------------------
BACKEND=docker          # -> templates/backend/docker.env
SCAFFOLD=cx             # -> templates/scaffold/cx.env
TRAINING_MODE=sync      # -> templates/verl/sync.env
MODEL_ENGINE=fsdp       # -> templates/verl/fsdp.env；具体 FSDP2 由 FSDP_STRATEGY 控制


# -----------------------------------------------------------------------------
# 0.1 实验身份（不属于模板；train.sh / verl 直接读取）
# -----------------------------------------------------------------------------
PROJECT_NAME=lego-rl-qwen35-2b-cx
# 带时间戳：保证每次运行的 trial / checkpoint / log 目录不覆盖
EXP_NAME=qwen35-2b-cx-docker-fsdp2-train-8gpu-$(date +%Y%m%d-%H%M%S)


# -----------------------------------------------------------------------------
# 1. 覆盖 templates/runtime/process.env
# -----------------------------------------------------------------------------
VENV_PATH=${REPO_ROOT}/.venv                # 训练器 Python 环境；runtime.sh 会 activate
# 会被导出为 GLOO/TP/NCCL_SOCKET_IFNAME；必须是实际承载 Ray/NCCL 流量的网卡
TRAIN_NETWORK_INTERFACE=ens5f1
DOCKER_BUILDKIT=1                           # 构建任务镜像时用 BuildKit；本配置不 build 任务镜像
RAY_OBJECT_STORE_MEMORY=6000000000          # Ray object store ≈6 GB


# -----------------------------------------------------------------------------
# 2. 覆盖 templates/backend/docker.env
# -----------------------------------------------------------------------------
# docker.env 本身只设置 HARBOR_ENVIRONMENT_TYPE=docker；下面两个不在模板内。
DOCKER_HOST=unix:///var/run/docker.sock     # 本地 daemon；远端改成 tcp://host:2375
HARBOR_ENVIRONMENT_TYPE=docker              # 与 backend/docker.env 保持一致
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.remote_docker:RemoteDockerEnvironment


# -----------------------------------------------------------------------------
# 3. 覆盖 templates/harbor/common.env
# -----------------------------------------------------------------------------
# --- 3.1 agent 轮数 / 超时 / 重试 ---
HARBOR_AGENT_MAX_ITERATIONS=60             # 单 trial 最大 assistant 轮数
HARBOR_AGENT_MAX_TIMEOUT_SEC=900            # agent 执行硬上限（秒）
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=900       # 覆盖 task.toml [agent].timeout_sec
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=3600       # validation trial 的超时
# 注意：这是“尝试次数”，不是额外重试次数。1 = 只跑一次。
HARBOR_MAX_RETRIES=1
# 注意：0 会让 for attempt in range(0) 一次都不跑。当前 validation 关闭所以无影响；
# 以后打开 TRAINER_TEST_FREQ / TRAINER_VAL_BEFORE_TRAIN 时请改成 >=1。
HARBOR_VAL_MAX_RETRIES=0
HARBOR_TRAJECTORY_SELECTION=all         # 多段轨迹选最长；all=保留全部段
HARBOR_MAX_CONSECUTIVE_NO_TOOL=3            # 连续 3 次无 tool call 判定异常
# Codex native compaction：窗口与模型一致，达到约 90% 时自动摘要并继续。
HARBOR_CONTEXT_BUDGET_TOKENS=65536
HARBOR_COMPACTION_MAX=3
HARBOR_TRIAL_GEN_TOKEN_BUDGET=128000
HARBOR_COMPACTION_TRAIN_SUMMARY=1

# --- 3.2 environment 资源 / 生命周期 ---
# False = 直接用 task.toml [environment].docker_image，不重新 build 任务 Dockerfile
HARBOR_ENVIRONMENT_FORCE_BUILD=False
# False = down 时不加 --rmi all，保留预构建镜像
HARBOR_ENVIRONMENT_DELETE=False
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2          # 覆盖 task.toml 的容器 CPU 限制
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192  # 覆盖 task.toml 的容器内存限制（8 GiB）
HARBOR_VERIFIER_ENABLED=True                # 跑 verifier，用其 reward 作为 RL 奖励


# -----------------------------------------------------------------------------
# 4. 覆盖 templates/verl/common.env
# -----------------------------------------------------------------------------
# --- 4.1 模型 ---
MODEL_PATH=${LEGO_MODEL_PATH:-/mnt/data/models/Qwen3.5-2B}  # HF checkpoint
SERVED_MODEL_NAME=vllm_model                # vLLM served name，也是 agent 请求里的 model 名
TOOL_CALL_PARSER=qwen3_coder                # 必须和模型 chat template 匹配

# --- 4.2 dense 模型开关（MoE 才能打开）---
ENABLE_R3=False                             # routing replay；dense 误开会在引擎初始化报错/静默无效
ENABLE_ROLLOUT_ROUTING_REPLAY=False         # vLLM rollout 侧 R3；跟随 ENABLE_R3
VLLM_ENABLE_EXPERT_PARALLEL=False           # vLLM expert parallel；dense 打开会被 vLLM 拒绝

# --- 4.3 数据 ---
# DEFAULT_INDEX 是 config-only 的默认路径；先定义，下面 TRAIN_FILES 才能引用
SPIDER_DATA_ROOT=${REPO_ROOT}/data/spider-test/split-9-1
DEFAULT_INDEX=${SPIDER_DATA_ROOT}/train/index/train_1932.parquet
DEFAULT_VAL_INDEX=${SPIDER_DATA_ROOT}/val/index/val_215.parquet
TRAIN_FILES=${LEGO_TRAIN_FILES:-${DEFAULT_INDEX}}       # 可用 LEGO_TRAIN_FILES 覆盖
VAL_FILES=${LEGO_VAL_FILES:-${DEFAULT_VAL_INDEX}}       # 可用 LEGO_VAL_FILES 覆盖
# Spider task compose files expand this exact variable to mount per-task SQLite DBs.
: "${SPIDER1_TEST_DATA_ROOT:=${SPIDER_DATA_ROOT}/data}"
export SPIDER1_TEST_DATA_ROOT

# --- 4.4 拓扑 ---
NNODES=1                                    # 总节点数
NGPUS_PER_NODE=8                            # trainer.n_gpus_per_node
N_NODES_TRAIN=1                             # async 下训练节点数；sync 用 NNODES
N_NODES_ROLLOUT=0                           # async 下 rollout 节点数；sync 为 0
SP_SIZE=1                                   # Ulysses SP；SP=1 -> 8 个纯 DP rank
GEN_TP=1                                    # vLLM TP；1 个 replica 占 1 张卡

# --- 4.5 batch / rollout 并发 ---
TRAIN_BSZ=2                                 # 通用 batch 变量（也用于 trial 数估算）
TRAIN_MINI_BSZ=2                            # actor.ppo_mini_batch_size
N_RESP=4                                    # rollout.n：每个 prompt 采 4 条
VAL_N=1                                     # rollout.val_kwargs.n
AGENT_NUM_WORKERS=4                         # 并发 agent loop worker 数，也是并发 trial 数

# --- 4.6 上下文 / 24 GiB 显存 ---
FUSED_KERNELS=True                          # use_fused_kernels
MAX_PROMPT=49152                            # data.max_prompt_length
MAX_RESP=16384                              # data.max_response_length
# 64K 总窗口：ROLLOUT_MAX_MODEL_LEN 应 >= MAX_PROMPT+MAX_RESP
ROLLOUT_MAX_MODEL_LEN=65536                 # vLLM max_model_len
VERL_AGENT_FULL_SEQUENCE_TRAINING=1         # 共享完整序列预算，避免长轨迹固定 response 列溢出
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=65536       # actor 动态 batch 的每卡 token 预算
GPU_MEM_UTIL=0.35                           # vLLM KV cache 比例；sync 共卡，给训练留一半显存
ENFORCE_EAGER=True                          # 关闭 CUDA graph，省显存
ENABLE_SLEEP_MODE=True                      # rollout/训练之间让 vLLM sleep 释放显存
ROLLOUT_MAX_NUM_SEQS=4                      # 每个 vLLM replica 的最大并发序列数
ENABLE_GRADIENT_CHECKPOINTING=True          # 重计算省激活显存
ENABLE_ACTIVATION_OFFLOAD=False             # 不把激活 offload 到 CPU

# --- 4.7 训练节奏 ---
ADV_ESTIMATOR=grpo                          # algorithm.adv_estimator
POLICY_LOSS_MODE=gspo                       # actor.policy_loss.loss_mode
LR_SCHEDULER=constant                       # actor.optim.lr_scheduler_type
ACTOR_LR=1e-6                               # actor.optim.lr
TOTAL_EPOCHS=2                              # trainer.total_epochs
TRAINER_SAVE_FREQ=100                       # 每 100 step 存一次 checkpoint
MAX_ACTOR_CKPT_TO_KEEP=3                    # 只保留最近 3 个 actor checkpoint
TRAINER_TEST_FREQ=-1                        # -1 = 关闭周期性 validation
TRAINER_VAL_BEFORE_TRAIN=False              # 训练前不跑 validation
TRAINER_LOGGER="['console']"                # 只输出 console，不初始化 wandb
WANDB_MODE=disabled                         # 再次确保 wandb 不启动


# -----------------------------------------------------------------------------
# 5. 覆盖 templates/verl/sync.env
# -----------------------------------------------------------------------------
TRAIN_PROMPT_BSZ=2                          # -> data.train_batch_size（真正生效的 batch）
VAL_BSZ=1                                   # -> data.val_batch_size


# -----------------------------------------------------------------------------
# 6. 覆盖 templates/verl/fsdp.env
# -----------------------------------------------------------------------------
FSDP_STRATEGY=fsdp2                         # actor/ref fsdp_config.strategy
FSDP_SIZE=-1                                # -1 = 全 world 一起 shard
# FSDP1 旧开关保持 False；FSDP2 用下面的 offload_policy
ACTOR_FSDP_PARAM_OFFLOAD=False
ACTOR_FSDP_OPTIMIZER_OFFLOAD=False
ACTOR_FSDP_OFFLOAD_POLICY=False             # actor 参数和 optimizer 均不 offload 到 CPU
REF_FSDP_PARAM_OFFLOAD=False
REF_FSDP_OFFLOAD_POLICY=True                # ref 只做 forward，CPUOffloadPolicy 省显存


# -----------------------------------------------------------------------------
# 7. 覆盖 templates/scaffold/cx.env
# -----------------------------------------------------------------------------
# Docker 版 loop；cx.env 默认的是 K8s loop，这里必须覆盖
AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_cx_docker.yaml
HARBOR_AGENT_IMPORT_PATH=harbor_patch.agents.image_mounted_codex:Codex
# 必须 null：非 null 的已知 agent 名会让 Harbor 忽略 import_path，走内置 npm 安装
HARBOR_AGENT_NAME=null
# Codex adapter 会硬断言这个版本；必须和镜像里的 codex --version 完全一致
HARBOR_AGENT_VERSION=0.144.1
# null = runtime 已烘焙进任务镜像，不做 staging / bind mount
HARBOR_AGENT_RUNTIME_IMAGE=null
# 容器内 runtime 根目录，注入为 CUSTOM_AGENT_RUNTIME_ROOT
HARBOR_AGENT_RUNTIME_MOUNT_PATH=/opt/custom-agent-runtime/codex
# 回退到旧挂载模式时，取消下面两行注释：
# HARBOR_AGENT_RUNTIME_IMAGE=<runtime image>
# HARBOR_AGENT_RUNTIME_IMAGE_SUBPATH=opt/custom-agent-runtime/codex
# 旧 Codex runtime 镜像若是 FROM scratch（无 shell），还需要：
# HARBOR_DOCKER_RUNTIME_STAGE_HELPER_IMAGE=alpine:3.20

# Codex 走 OpenAI Responses API；loop 每个 trial 会把占位替换成 proxy 地址/密钥
HARBOR_OPENAI_BASE_URL=http://127.0.0.1:8002/v1
HARBOR_OPENAI_API_KEY=sk-dummy
CODEX_REASONING_EFFORT=medium               # Codex 的 reasoning effort


# -----------------------------------------------------------------------------
# 8. 不属于模板：Harbor Docker build / 进程 / 编译直接读取
# -----------------------------------------------------------------------------
HARBOR_DOCKER_BUILD_CONCURRENCY=2           # Harbor Docker build 全局信号量（本配置不 build）
# 仅任务镜像 build 的 RUN 步骤使用；不设置就完全不走代理
HARBOR_DOCKER_BUILD_PROXY=${LEGO_DOCKER_BUILD_PROXY-}
HARBOR_DOCKER_BUILD_NO_PROXY=${LEGO_DOCKER_BUILD_NO_PROXY:-localhost,127.0.0.1,::1,host.docker.internal,192.168.19.3,172.17.0.1,.local}

CUDA_HOME=/usr/local/cuda-12.8
LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH:-}
CUDA_VISIBLE_DEVICES=${LEGO_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}
# TileLang 的 FLA backward 需要 C++20；优先用系统 GCC 11
NVCC_PREPEND_FLAGS="-ccbin /usr/bin/g++-11"


# -----------------------------------------------------------------------------
# 9. 模板组合（source 顺序有意义：先默认值，后派生值）
# -----------------------------------------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  harbor/compaction.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
