# Qwen3.5-2B + Claude Code + Docker + FSDP2 training on Lego-RL-2699.
#
# Hardware target: eight RTX 4090 D GPUs (24 GiB each), no NVLink.
# The model is dense, so routing replay and expert parallelism stay disabled.
# Training and rollout are colocated in synchronous mode.
#
# The Claude Code CLI is not installed into every task image. A pinned
# claude-code runtime image is extracted once by RemoteDockerEnvironment and
# mounted read-only into each task container at
# /opt/custom-agent-runtime/claude-code.

# --- template selection -----------------------------------------------
BACKEND=docker
SCAFFOLD=cc
TRAINING_MODE=sync
# MODEL_ENGINE selects the Verl FSDP template family; FSDP_STRATEGY selects FSDP2.
MODEL_ENGINE=fsdp

# --- identity ----------------------------------------------------------
PROJECT_NAME=lego-rl-qwen35-2b-cc
EXP_NAME=qwen35-2b-cc-docker-fsdp2-train-8gpu-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=${REPO_ROOT}/.venv
TRAIN_NETWORK_INTERFACE=ens5f1
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_BUILDKIT=1
HARBOR_DOCKER_BUILD_CONCURRENCY=2
# BuildKit RUN steps cannot reach the host through 127.0.0.1.
HARBOR_DOCKER_BUILD_PROXY=${LEGO_DOCKER_BUILD_PROXY-http://192.168.19.3:5429}
HARBOR_DOCKER_BUILD_NO_PROXY=${LEGO_DOCKER_BUILD_NO_PROXY:-localhost,127.0.0.1,::1,host.docker.internal,192.168.19.3,172.17.0.1,.local}
RAY_OBJECT_STORE_MEMORY=6000000000
CUDA_HOME=/usr/local/cuda-12.8
LD_LIBRARY_PATH=/usr/local/cuda-12.8/lib64:${LD_LIBRARY_PATH:-}
CUDA_VISIBLE_DEVICES=${LEGO_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}

# The CC scaffold template defaults to the Kubernetes loop. Docker needs the
# explicit RemoteDocker loop that mounts the Claude Code runtime image.
AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_cc_docker.yaml

# --- model -------------------------------------------------------------
MODEL_PATH=${LEGO_MODEL_PATH:-/mnt/data/models/Qwen3.5-2B}
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder

ENABLE_R3=False
ENABLE_ROLLOUT_ROUTING_REPLAY=False
VLLM_ENABLE_EXPERT_PARALLEL=False

# --- data --------------------------------------------------------------
DEFAULT_INDEX=${REPO_ROOT}/data/Lego-RL-subset-64/index/train_64.parquet
TRAIN_FILES=${LEGO_TRAIN_FILES:-${DEFAULT_INDEX}}
VAL_FILES=${LEGO_VAL_FILES:-${TRAIN_FILES}}

# --- topology ----------------------------------------------------------
NNODES=1
NGPUS_PER_NODE=8
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# SP=1 gives eight data-parallel ranks. vLLM remains one GPU per replica.
SP_SIZE=1
GEN_TP=1
FSDP_STRATEGY=fsdp2
FSDP_SIZE=-1

# --- training scale ----------------------------------------------------
TRAIN_BSZ=2
TRAIN_PROMPT_BSZ=2
TRAIN_MINI_BSZ=2
N_RESP=4
VAL_BSZ=1
VAL_N=1

# --- context and 24 GiB memory controls -------------------------------
FUSED_KERNELS=True
# TileLang's FLA backward kernels require C++20. Prefer the installed GCC 11.
NVCC_PREPEND_FLAGS="-ccbin /usr/bin/g++-11"
MAX_PROMPT=61440
MAX_RESP=20480
# 80K total context: prioritize agent-rollout input over generation budget.
ROLLOUT_MAX_MODEL_LEN=81920
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=81920
GPU_MEM_UTIL=0.50
ENFORCE_EAGER=True
ENABLE_SLEEP_MODE=True
ROLLOUT_MAX_NUM_SEQS=8
ENABLE_GRADIENT_CHECKPOINTING=True
ENABLE_ACTIVATION_OFFLOAD=False

# FSDP2 uses CPUOffloadPolicy for parameter/optimizer movement across devices.
# The legacy FSDP1 param/optimizer offload flags stay disabled.
ACTOR_FSDP_PARAM_OFFLOAD=False
ACTOR_FSDP_OPTIMIZER_OFFLOAD=False
ACTOR_FSDP_OFFLOAD_POLICY=False
REF_FSDP_PARAM_OFFLOAD=False
REF_FSDP_OFFLOAD_POLICY=True

# --- agent / sandbox ---------------------------------------------------
AGENT_NUM_WORKERS=4

HARBOR_AGENT_IMPORT_PATH=harbor_patch.agents.image_mounted_claude_code:ClaudeCode
HARBOR_AGENT_NAME=null
HARBOR_AGENT_VERSION=2.1.207
HARBOR_AGENT_RUNTIME_IMAGE=jierun/c-cc-2.1.207:v0.1
HARBOR_AGENT_RUNTIME_MOUNT_PATH=/opt/custom-agent-runtime/claude-code
HARBOR_AGENT_RUNTIME_IMAGE_SUBPATH=opt/custom-agent-runtime/claude-code
HARBOR_CUSTOM_AGENT_CLAUDE=/opt/custom-agent-runtime/claude-code/bin/claude
HARBOR_CUSTOM_AGENT_RUNTIME_ENV_SCRIPT=/opt/custom-agent-runtime/claude-code/runtime-env.sh

# Claude Code speaks Anthropic Messages; BuiltinSWEAgentLoop rewrites this
# placeholder to a per-trial in-process proxy URL.
HARBOR_ANTHROPIC_API_KEY=sk-dummy
HARBOR_ANTHROPIC_MODEL=${SERVED_MODEL_NAME}
CLAUDE_CODE_ATTRIBUTION_HEADER=0

HARBOR_AGENT_MAX_ITERATIONS=50
HARBOR_AGENT_MAX_TIMEOUT_SEC=900
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=900
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=3600
HARBOR_MAX_RETRIES=1
HARBOR_VAL_MAX_RETRIES=0
HARBOR_TRAJECTORY_SELECTION=longest
HARBOR_MAX_CONSECUTIVE_NO_TOOL=3

HARBOR_ENVIRONMENT_TYPE=docker
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.remote_docker:RemoteDockerEnvironment
HARBOR_ENVIRONMENT_FORCE_BUILD=False
HARBOR_ENVIRONMENT_DELETE=False
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_VERIFIER_ENABLED=True

# --- training cadence --------------------------------------------------
ADV_ESTIMATOR=grpo
POLICY_LOSS_MODE=gspo
LR_SCHEDULER=constant
ACTOR_LR=1e-6
TOTAL_EPOCHS=1
TRAINER_SAVE_FREQ=16
MAX_ACTOR_CKPT_TO_KEEP=3
TRAINER_TEST_FREQ=-1
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_LOGGER="['console']"
WANDB_MODE=disabled

# --- template composition ---------------------------------------------
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
